{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/offline/sw.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/offline" }
      ]
    }
  ]
}
